# Generated inference outputs
output.wav
output.json
outputs/

# Examples: default output folders (--out-dir), e.g. examples/example1/output/
examples/*/output/
# example1: generated files if --out-dir points elsewhere inside example1/
examples/example1/**/input.wav
examples/example1/**/agent.wav
examples/example1/**/agent.json
examples/example1/**/conversation.wav
examples/example1/**/conversation_live.wav
examples/example1/**/transcript.txt
# example1: per-turn text-to-speech clips (normally in a system temp dir)
examples/example1/**/turn[0-9][0-9].wav
examples/example1/**/tmp*/

# MLX (personaplex-mlx, examples/example3)
mlx-trace.json

# Node (web client)
node_modules/
